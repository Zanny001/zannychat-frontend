{
  "expo": {
    "name": "ZannyChat",
    "slug": "zannychat",
    "scheme": "zannychat",
    "version": "1.2.243",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zannychat.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ZannyChat uses the camera so you can take and send photos in your chats.",
        "NSMicrophoneUsageDescription": "ZannyChat uses the microphone so you can record and send voice messages.",
        "NSPhotoLibraryUsageDescription": "ZannyChat accesses your photo library so you can send photos and set a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "ZannyChat can save photos from your chats to your photo library.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "bitcode": false
    },
    "android": {
      "package": "com.zannychat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15111C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "zannychat",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "zannychat",
              "host": "reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "zannychat",
              "host": "contact",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF6A4D",
          "sounds": [
            "./assets/sounds/call_ring.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ZannyChat uses the camera to scan QR codes and connect you with contacts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ZannyChat accesses your photo library so you can send photos and set a profile picture.",
          "cameraPermission": "ZannyChat uses the camera so you can take and send photos in your chats."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ZannyChat uses the microphone so you can record and send voice messages."
        }
      ],
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "ZannyChat accesses your photo library so you can save images and videos shared in chats.",
          "savePhotosPermission": "ZannyChat saves images and videos you choose to keep from your chats.",
          "granularPermissions": []
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ZannyChat accesses your contacts only when you choose Import contacts, so you can select which phone numbers to check for registered members."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "ZannyChat uses the camera only when you start or answer a video call.",
          "microphonePermission": "ZannyChat uses the microphone only when you start or answer a call."
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#15111C"
        }
      ],
      [
        "expo-callkit-telecom",
        {
          "sounds": [
            "./assets/sounds/call_ring.wav",
            "./assets/sounds/call_dialtone.wav"
          ],
          "defaultRingtoneIos": "call_ring.wav",
          "defaultRingtoneAndroid": "call_ring.wav",
          "defaultDialtone": "call_dialtone.wav",
          "incomingCallTimeout": 65,
          "outgoingCallTimeout": 65,
          "fulfillAnswerCallTimeout": 30,
          "microphonePermission": "ZannyChat needs the microphone to make calls.",
          "notificationStringsAndroid": {
            "default": {
              "channelIncomingName": "ZannyChat incoming calls",
              "channelIncomingDescription": "Alerts for incoming voice and video calls",
              "channelOngoingName": "ZannyChat ongoing calls",
              "channelOngoingDescription": "Notifications for active calls",
              "incomingCall": "Incoming call",
              "incomingVideoCall": "Incoming video call",
              "dialing": "Calling...",
              "ongoingCall": "Ongoing call",
              "callEnded": "Call ended",
              "unknownCaller": "ZannyChat contact",
              "answer": "Answer",
              "decline": "Decline"
            }
          },
          "androidEventReceiver": ".CallEndedReceiver"
        }
      ],
      "./plugins/withCallEndedReceiver",
      "@livekit/react-native-expo-plugin"
    ],
    "extra": {
      "eas": {
        "projectId": "2c65f95e-6b35-449a-b75a-fee39fc807a5"
      },
      "backendUrl": "https://zannychat-backend-1.onrender.com"
    },
    "owner": "zannie"
  }
}
