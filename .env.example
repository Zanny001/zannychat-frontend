# Copy this file to ".env" once the backend's Supabase project exists.
# Expo automatically exposes any EXPO_PUBLIC_* var to the app bundle —
# no extra config needed. Until these are set, the app runs on mock
# data (see src/services/mockData.js) so it's fully demoable on its own.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional Express service from zannychat-backend, running locally
# (e.g. http://localhost:3000) or in a dedicated development environment.
# Leave empty to keep the app in mock-data mode. Never use production URLs
# during UI development unless you intentionally want to test production.
EXPO_PUBLIC_BACKEND_URL=

# Optional support contact shown in Profile → Help. Leave empty until a real inbox is available.
EXPO_PUBLIC_SUPPORT_EMAIL=
