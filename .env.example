# Copy this file to ".env" once the backend's Supabase project exists.
# Expo automatically exposes any EXPO_PUBLIC_* var to the app bundle —
# no extra config needed. Until these are set, the app runs on mock
# data (see src/services/mockData.js) so it's fully demoable on its own.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Express service from zannychat-backend, once deployed to Render
# (or running locally, e.g. http://localhost:3000). Powers "start a new
# chat" and the Wallet tab's real balance — everything else talks to
# Supabase directly and doesn't need this.
EXPO_PUBLIC_BACKEND_URL=
