# Include Firebase Android client configuration for local EAS builds.
!google-services.json

# Never upload private credentials or signing material.
*service-account*.json
*firebase-admin*.json
*private-key*.json
credentials*.json
*.pem
*.p12
*.p8
*.key

# Exclude native build artifacts and local simulator credentials.
**/local.properties
**/.gradle/
android/app/build/
ios/Pods/
ios/build/
.env.eas-simulator

# Exclude Android/iOS signing material.
*.jks
*.keystore
*.mobileprovision
